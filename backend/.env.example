# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres (docker compose maps host 5434 -> container 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/swarmdev

# Required. Server refuses to start without it. Use a long random value.
JWT_SECRET=

# Required. 32-byte key for encrypting provider credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# File storage root for agent/project workspaces (defaults to ./data/storage)
STORAGE_ROOT=

# Optional: workspace directory synced into the official marketplace listing.
# When unset or missing, a fallback starter template is generated.
OFFICIAL_AGENT_WORKSPACE=

# Optional: JSON array overriding the built-in API agent catalog.
# Entries need protocol (openai|anthropic), model, and systemPrompt.
API_AGENT_CATALOG=

# Slack integration (optional). Credentials saved per agent/team in the UI
# take precedence; these are workspace-wide fallbacks.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Public base URL Slack can reach for event callbacks (e.g. an ngrok tunnel).
SLACK_PUBLIC_BASE_URL=
# How long a Slack-triggered team run waits before replying "still working" (ms, default 600000).
SLACK_TEAM_TIMEOUT_MS=
